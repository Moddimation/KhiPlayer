{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "khinsider-remote",
  "description": "Lets the khinsider site call the presence commands, and (mobile) start/check the Discord login.",
  "windows": ["main"],
  "remote": { "urls": ["https://downloads.khinsider.com/*"] },
  "permissions": [
    "allow-set-presence",
    "allow-clear-presence",
    "allow-connect-discord",
    "allow-discord-connected",
    "allow-report-playback",
    "allow-report-now-playing-meta",
    "allow-get-now-playing",
    "allow-player-control",
    "opener:default",
    "deep-link:default",
    "media-session:default"
  ]
}
